APP_NAME=CoursePilot API
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173

DATABASE_URL=sqlite:///./coursepilot.db

# Required outside development; startup rejects empty values and public placeholders.
# Generate a private key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Optional one-time system administrator bootstrap
BOOTSTRAP_SYSTEM_ADMIN_NAME=System Administrator
BOOTSTRAP_SYSTEM_ADMIN_EMAIL=
BOOTSTRAP_SYSTEM_ADMIN_PASSWORD=
